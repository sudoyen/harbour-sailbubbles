diff --git a/anisette/anisette.m b/anisette/anisette.m
new file mode 100644
index 0000000..d57b0bf
--- /dev/null
+++ b/anisette/anisette.m
@@ -0,0 +1,56 @@
+#include "anisette.h"
+#include <dlfcn.h>
+
+static char *fail(char **err, NSString *msg) {
+	*err = strdup(msg.UTF8String);
+	return NULL;
+}
+
+static id call(id target, NSString *selector) {
+	SEL sel = NSSelectorFromString(selector);
+	return [target respondsToSelector:sel] ? [target performSelector:sel] : nil;
+}
+
+// Same calls as rustpush's AOSKit provider (omnisette/src/aos_kit.rs).
+// Returns a malloc'd JSON object of anisette headers, or NULL with *err set.
+char *anisetteHeadersJSON(char **err) {
+	@autoreleasepool {
+		if (!dlopen("/System/Library/PrivateFrameworks/AOSKit.framework/AOSKit", RTLD_LAZY)
+				|| !dlopen("/System/Library/PrivateFrameworks/AuthKit.framework/AuthKit", RTLD_LAZY))
+			return fail(err, [NSString stringWithUTF8String:dlerror()]);
+
+		Class aos = NSClassFromString(@"AOSUtilities");
+		Class akDevice = NSClassFromString(@"AKDevice");
+		if (!aos || !akDevice)
+			return fail(err, @"AOSUtilities or AKDevice not found");
+
+		SEL otpSel = NSSelectorFromString(@"retrieveOTPHeadersForDSID:");
+		if (![aos respondsToSelector:otpSel])
+			return fail(err, @"AOSUtilities has no retrieveOTPHeadersForDSID:");
+		NSDictionary *otp = [aos performSelector:otpSel withObject:@"-2"];
+		id device = call(akDevice, @"currentDevice");
+
+		NSDictionary *values = @{
+			@"X-Apple-I-MD": otp[@"X-Apple-MD"] ?: [NSNull null],
+			@"X-Apple-I-MD-M": otp[@"X-Apple-MD-M"] ?: [NSNull null],
+			@"X-Apple-I-MD-LU": call(device, @"localUserUUID") ?: [NSNull null],
+			@"X-Mme-Device-Id": call(device, @"uniqueDeviceIdentifier") ?: [NSNull null],
+		};
+		for (NSString *key in values)
+			if (values[key] == [NSNull null])
+				return fail(err, [NSString stringWithFormat:@"AOSKit gave no %@", key]);
+
+		NSMutableDictionary *headers = [values mutableCopy];
+		[headers autorelease];
+		NSISO8601DateFormatter *iso = [[[NSISO8601DateFormatter alloc] init] autorelease];
+		headers[@"X-Apple-I-Client-Time"] = [iso stringFromDate:[NSDate date]];
+		headers[@"X-Apple-I-TimeZone"] = [[NSTimeZone localTimeZone] abbreviation] ?: @"UTC";
+		headers[@"X-Apple-Locale"] = [[NSLocale currentLocale] localeIdentifier];
+
+		NSError *jsonErr = nil;
+		NSData *json = [NSJSONSerialization dataWithJSONObject:headers options:0 error:&jsonErr];
+		if (!json)
+			return fail(err, jsonErr.localizedDescription);
+		return strndup(json.bytes, json.length);
+	}
+}
