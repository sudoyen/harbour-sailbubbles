diff --git a/anisette/anisette.go b/anisette/anisette.go
new file mode 100644
index 0000000..e56d452
--- /dev/null
+++ b/anisette/anisette.go
@@ -0,0 +1,25 @@
+// Package anisette mints anisette headers on this Mac through AOSKit, so
+// sign-ins carry a machine ID that matches the Mac's own identity.
+package anisette
+
+//#cgo CFLAGS: -x objective-c -Wno-deprecated-declarations
+//#cgo LDFLAGS: -framework Foundation
+//#include "anisette.h"
+//#include <stdlib.h>
+import "C"
+import (
+	"encoding/json"
+	"errors"
+	"unsafe"
+)
+
+func Headers() (json.RawMessage, error) {
+	var cerr *C.char
+	out := C.anisetteHeadersJSON(&cerr)
+	if out == nil {
+		defer C.free(unsafe.Pointer(cerr))
+		return nil, errors.New(C.GoString(cerr))
+	}
+	defer C.free(unsafe.Pointer(out))
+	return json.RawMessage(C.GoString(out)), nil
+}
